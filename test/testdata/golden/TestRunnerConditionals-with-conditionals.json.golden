  "TestCase": {
    "filePath": "",
    "funcDecl": "// TestRunnerConditionals validates that conditional analysis only detects\n// conditionals inside the runner loop (such as the assertion in the subtest)\n// and ignores conditionals outside the runner loop (such as the length check).\nfunc TestRunnerConditionals(t *testing.T) {\n\ttests := []scenario{\n\t\t{name: \"positive\", input: 2, want: 4},\n\t}\n\t// Conditional outside the runner loop should be ignored by conditional analysis\n\tif len(tests) == 0 {\n\t\tt.Fatalf(\"no tests\")\n\t}\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tgot := tc.input * 2\n\t\t\t// Conditional INSIDE the runner loop (should be DETECTED)\n\t\t\tif got != tc.want {\n\t\t\t\tt.Errorf(\"got %d, want %d\", got, tc.want)\n\t\t\t}\n\t\t})\n\t}\n}",
    "importPath": "",
    "name": "TestRunnerConditionals",
    "package": "sampleproj",
    "project": ""
  }
