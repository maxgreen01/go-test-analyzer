// 
// This file is an annotated example of the JSON files generated by the Go Test Analysis Engine's `analyze`
// command. Each JSON file contains detailed information about the corresponding test, its table-driven features,
// and the result of refactoring and executing it, if applicable.
// 
// -----------------------------------------------------------------------------------------------------------
// This example is compatible with the latest version of the Go Test Analysis Engine.
// For older versions, refer to this file at the appropriate version tag in the source repository.
// -----------------------------------------------------------------------------------------------------------
// 
// 
// These JSON files each represent a single test case, and are named like "<project>_<package>_<testName>_<hash>.json".
// The `<hash>` is the raw URL-safe Base64 encoding of the first 5 bytes of the MD5 hash of the test's full import path.
// The `analyze` command automatically generates one such file for each test detected in the specified project,
// and saves them in a new folder named like "<package>" in the same directory as the main `output` file.
// These normally have the plain ".json" extension, but this annotated example is ".jsonc" to allow for comments.
// 
// This example is based on the real-world `TestAlertingRuleState` test in the Prometheus project, with some minor
// modifications to more thoroughly illustrate all possible features of the JSON output.
// 
// 
// Each of these JSON files represents a test at the time that it was analyzed, and are not modified unless the
// corresponding test is re-analyzed.
// 
{
  // The "TestCase" object contains identifying information about the test that this file represents.
  "TestCase": {
    // The name of the test function itself.
    "name": "TestAlertingRuleState",
    
    // The package where the test case is defined, as it appears in the source file's `package` statement.
    "package": "rules",

    // The full import path of the package where the test case is defined.
    "importPath": "github.com/prometheus/prometheus/rules",
    
    // The absolute path to the file where the test case is defined.
    "filePath": "D:\\go-projects\\prometheus\\rules\\alerting_test.go",
    
    // The name of the overarching project that the test case is part of, as specified by the user.
    "project": "prometheus",
    
    // The original declaration of the test function, based on its AST representation.
    "funcDecl": "func TestAlertingRuleState(t *testing.T) {\n\ttests := []struct {\n\t\tname   string\n\t\tactive map[uint64]*Alert\n\t\twant   AlertState\n\t}{\n\t\t{\n\t\t\tname: \"MaxStateFiring\",\n\t\t\tactive: map[uint64]*Alert{\n\t\t\t\t0: {State: StatePending},\n\t\t\t\t1: {State: StateFiring},\n\t\t\t},\n\t\t\twant: StateFiring,\n\t\t},\n\t\t{\n\t\t\tname: \"MaxStatePending\",\n\t\t\tactive: map[uint64]*Alert{\n\t\t\t\t0: {State: StateInactive},\n\t\t\t\t1: {State: StatePending},\n\t\t\t},\n\t\t\twant: StatePending,\n\t\t},\n\t\t{\n\t\t\tname: \"MaxStateInactive\",\n\t\t\tactive: map[uint64]*Alert{\n\t\t\t\t0: {State: StateInactive},\n\t\t\t\t1: {State: StateInactive},\n\t\t\t},\n\t\t\twant: StateInactive,\n\t\t},\n\t}\n\n\tfor i, test := range tests {\n\t\trule := NewAlertingRule(test.name, nil, 0, 0, labels.EmptyLabels(), labels.EmptyLabels(), labels.EmptyLabels(), \"\", true, nil)\n\t\trule.active = test.active\n\t\tgot := rule.State()\n\t\trequire.Equal(t, test.want, got, \"test case %d unexpected AlertState, want:%d got:%d\", i, test.want, got)\n\t\tvalidateState(t, got)\n\t}\n}"
  },
  
  // The "ScenarioSet" object contains information about the table-driven features of a test, if applicable.
  // If the test is not table-driven, the fields will mostly be empty, false, or null.
  "ScenarioSet": {
    // The underlying data type used to define each scenario in a table-driven test.
    // 
    // If scenarios are defined using a list of structs, this will be the type of the structs in the list.
    // If scenarios are defined using a map, this will be the type of the value corresponding to each map key.
    "scenarioType": "struct{name string; active map[uint64]*github.com/prometheus/prometheus/rules.Alert; want github.com/prometheus/prometheus/rules.AlertState}",
    
    // A string describing the data structure used to store all scenarios in a table-driven test.
    // 
    // If scenarios are defined using a slice or array of structs, this will be "struct list".
    // If scenarios are defined using a map, this will be "map".
    // If scenarios are defined using a slice or array of non-struct elements, this will be "non-struct list".
    // If scenarios are defined using any other data structure, this will be "other".
    // If the test is not table-driven, this will be "none".
    "dataStructure": "struct list",
    
    // The individual scenarios themselves, based on their AST representations.
    "scenarios": [
      "{\n\tname: \"MaxStateFiring\",\n\tactive: map[uint64]*Alert{\n\t\t0: {State: StatePending},\n\t\t1: {State: StateFiring},\n\t},\n\twant: StateFiring,\n},",
      "{\n\tname: \"MaxStatePending\",\n\tactive: map[uint64]*Alert{\n\t\t0: {State: StateInactive},\n\t\t1: {State: StatePending},\n\t},\n\twant: StatePending,\n},",
      "{\n\tname: \"MaxStateInactive\",\n\tactive: map[uint64]*Alert{\n\t\t0: {State: StateInactive},\n\t\t1: {State: StateInactive},\n\t},\n\twant: StateInactive,\n},"
    ],
    
    // The loop statement that executes each of the test scenarios, based on its AST representation.
    "runner": "for i, test := range tests {\n\trule := NewAlertingRule(test.name, nil, 0, 0, labels.EmptyLabels(), labels.EmptyLabels(), labels.EmptyLabels(), \"\", true, nil)\n\trule.active = test.active\n\tgot := rule.State()\n\trequire.Equal(t, test.want, got, \"test case %d unexpected AlertState, want:%d got:%d\", i, test.want, got)\n\tvalidateState(t, got)\n}",
    
    // The name of the variable representing the scenario data structure, which is iterated over by the runner loop
    "scenarioStructName": "tests",

    // The name of the struct field representing each scenario's name.
    // This can also be "map key" if scenarios are defined using a map whose key type is string. 
    "nameField": "name",

    // The names of the struct fields representing the expected results of each scenario.
    "expectedFields": [
      "want"
    ],

    // A boolean indicating whether the scenario data type includes any function-typed struct fields.
    "hasFunctionFields": false,

    // A boolean indicating whether the test uses the `t.Run` method to execute each scenario as a subtest.
    "usesSubtest": false,

    // A boolean indicating whether the test is table-driven, based on the presence of a scenario data structure
    // that contains at least one explicitly-defined scenario.
    "isTableDriven": true
  },

  // The "ParsedStatements" array contains a list of all the statements in the test, which are recursively
  // expanded and stored as G-trees based on their AST representations. Each statement is expanded based on the
  // following rules:
  // 
  //  - At each recursive step, the statement to be expanded is stored in the `stmt` field.
  //  - If the statement is a function call, the function's own body statements are expanded recursively and
  //    stored in the `children` field of the function call.
  //  - If the statement indirectly involves function calls (e.g. as part of an assignment or conditional
  //    statement), those calls are also stored in the `children` field and similarly expanded.
  //  - If the statement uses function literals as arguments to a function call, those function literals are
  //    also stored in the `children` field and similarly expanded.
  //  - Any instances of indirect function calls or function literals are expanded and stored before the body
  //    statements of a called function.
  //  - Function calls are only expanded if they are defined inside a test file, which avoids expanding
  //    production code (because it is not the focus of the test analysis).
  //  - If the statement does not involve any function calls that should be expanded, its `children` field is
  //    omitted.
  "ParsedStatements": [
    {
      "stmt": "tests := []struct {\n\tname   string\n\tactive map[uint64]*Alert\n\twant   AlertState\n}{\n\t{\n\t\tname: \"MaxStateFiring\",\n\t\tactive: map[uint64]*Alert{\n\t\t\t0: {State: StatePending},\n\t\t\t1: {State: StateFiring},\n\t\t},\n\t\twant: StateFiring,\n\t},\n\t{\n\t\tname: \"MaxStatePending\",\n\t\tactive: map[uint64]*Alert{\n\t\t\t0: {State: StateInactive},\n\t\t\t1: {State: StatePending},\n\t\t},\n\t\twant: StatePending,\n\t},\n\t{\n\t\tname: \"MaxStateInactive\",\n\t\tactive: map[uint64]*Alert{\n\t\t\t0: {State: StateInactive},\n\t\t\t1: {State: StateInactive},\n\t\t},\n\t\twant: StateInactive,\n\t},\n}"
    },
    {
      "stmt": "for i, test := range tests {\n\trule := NewAlertingRule(test.name, nil, 0, 0, labels.EmptyLabels(), labels.EmptyLabels(), labels.EmptyLabels(), \"\", true, nil)\n\trule.active = test.active\n\tgot := rule.State()\n\trequire.Equal(t, test.want, got, \"test case %d unexpected AlertState, want:%d got:%d\", i, test.want, got)\n\tvalidateState(t, got)\n}",
      "children": [
        {
          "stmt": "NewAlertingRule(test.name, nil, 0, 0, labels.EmptyLabels(), labels.EmptyLabels(), labels.EmptyLabels(), \"\", true, nil)",
          "children": [
            {
              "stmt": "labels.EmptyLabels()"
            },
            {
              "stmt": "labels.EmptyLabels()"
            },
            {
              "stmt": "labels.EmptyLabels()"
            }
          ]
        },
        {
          "stmt": "rule.State()"
        },
        {
          "stmt": "require.Equal(t, test.want, got, \"test case %d unexpected AlertState, want:%d got:%d\", i, test.want, got)"
        },
        {
          "stmt": "validateState(t, got)",
          "children": [
            {
              "stmt": "for i := 0; i \u003c 3; i++ {\n\tif other := AlertState(i); other == state {\n\t\tif other.String() != state.String() {\n\t\t\tt.Errorf(\"unexpected AlertState string, want:%q got:%q\", other.String(), state.String())\n\t\t}\n\t}\n}",
              "children": [
                {
                  "stmt": "AlertState(i)"
                },
                {
                  "stmt": "other.String()"
                },
                {
                  "stmt": "state.String()"
                },
                {
                  "stmt": "t.Errorf(\"unexpected AlertState string, want:%q got:%q\", other.String(), state.String())",
                  "children": [
                    {
                      "stmt": "other.String()"
                    },
                    {
                      "stmt": "state.String()"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],

  // The "ImportedPackages" array contains a list of all packages imported in the file where the test is defined.
  "ImportedPackages": [
    "context",
    "errors",
    "testing",
    "time",
    "github.com/prometheus/common/model",
    "github.com/prometheus/common/promslog",
    "github.com/stretchr/testify/require",
    "github.com/prometheus/prometheus/model/histogram",
    "github.com/prometheus/prometheus/model/labels",
    "github.com/prometheus/prometheus/model/relabel",
    "github.com/prometheus/prometheus/model/timestamp",
    "github.com/prometheus/prometheus/notifier",
    "github.com/prometheus/prometheus/promql",
    "github.com/prometheus/prometheus/promql/parser",
    "github.com/prometheus/prometheus/promql/promqltest",
    "github.com/prometheus/prometheus/storage",
    "github.com/prometheus/prometheus/util/teststorage",
    "github.com/prometheus/prometheus/util/testutil"
  ],

  // The "RefactorResult" object contains information about the result of refactoring the test, even if no
  // refactoring was performed.
  "RefactorResult": {
    // The name of the refactoring strategy applied to the test, or "none".
    "strategy": "subtest",

    // A string describing the status of the refactor generation attempt. This does not indicate the correctness
    // or outcome of the refactoring.
    //
    // If refactoring was successful, this will be "success".
    // If refactoring failed based on the configuration of the scenario fields, this will be "badFields".
    //   For example, the "subtest" refactoring strategy requires scenarios to contain a suitable "name" field.
    // If refactoring failed unexpectedly (e.g. due to an unsupported AST structure) this will be "fail".
    // If refactoring failed because a `*testing.T` variable could not be detected, this will be "noTester".
    // If refactoring could not be performed due to an internal logic error, this will be "error".
    // If no refactoring was attempted, this will be "none".
    "status": "success",

    // An array representing the changes made during refactoring, if the refactor generation was successful.
    // Each element corresponds to a refactored function, in case helper functions need to be modified.
    "refactorings": [
      {
        // The refactored test declaration, based on its AST representation.
        "refactored": "func TestAlertingRuleState(t *testing.T) {\n\ttests := []struct {\n\t\tname   string\n\t\tactive map[uint64]*Alert\n\t\twant   AlertState\n\t}{\n\t\t{\n\t\t\tname: \"MaxStateFiring\",\n\t\t\tactive: map[uint64]*Alert{\n\t\t\t\t0: {State: StatePending},\n\t\t\t\t1: {State: StateFiring},\n\t\t\t},\n\t\t\twant: StateFiring,\n\t\t},\n\t\t{\n\t\t\tname: \"MaxStatePending\",\n\t\t\tactive: map[uint64]*Alert{\n\t\t\t\t0: {State: StateInactive},\n\t\t\t\t1: {State: StatePending},\n\t\t\t},\n\t\t\twant: StatePending,\n\t\t},\n\t\t{\n\t\t\tname: \"MaxStateInactive\",\n\t\t\tactive: map[uint64]*Alert{\n\t\t\t\t0: {State: StateInactive},\n\t\t\t\t1: {State: StateInactive},\n\t\t\t},\n\t\t\twant: StateInactive,\n\t\t},\n\t}\n\n\tfor i, test := range tests {\n\t\tt.Run(test.name, func(t *testing.T) {\n\t\t\trule := NewAlertingRule(test.name, nil, 0, 0, labels.EmptyLabels(), labels.EmptyLabels(), labels.EmptyLabels(), \"\", true, nil)\n\t\t\trule.active = test.active\n\t\t\tgot := rule.State()\n\t\t\trequire.Equal(t, test.want, got, \"test case %d unexpected AlertState, want:%d got:%d\", i, test.want, got)\n\t\t})\n\t}\n}",
        
        // The absolute path to the file where the refactored function is defined.
        "filePath": "D:\\go-projects\\prometheus\\rules\\alerting_test.go",

        // A boolean indicating whether this is a helper function rather than the test function itself.
        "isHelper": false
      }
    ],

    // A string representing the result of executing the test before refactoring. For performance reasons,
    // a test is only executed if refactoring was attempted and its refactor generation was successful.
    // 
    // If the test passed successfully, this will be "pass".
    // If the test failed, this will be "fail".
    // If the test was skipped, this will be "skip".
    // If the test could not execute due to a compilation error, this will be "compilationError".
    // If the test was executed but its result could not be determined, this will be "unknown".
    // If the test was not executed (e.g. because it was not refactored), this will be "notRun".
    "originalTestResult": "pass",

    // A string representing the result of executing the test after refactoring to validate behavior.
    // This follows the same structure as the "originalTestResult" field.
    "refactoredTestResult": "pass"
  },


  // 
  // -----------------------------------------------------------------------------------------
  // The following fields correspond to additional, more detailed analyses of various aspects
  // of the test case, and are only included if the corresponding command options are set.
  // -----------------------------------------------------------------------------------------
  // 
  // 
  // Some fields in these objects are "metadata features", which represent specific
  // characteristics of the structures being analyzed. These features have a consistent
  // output format across the different fields where they are used.
  // 
  // Metadata features that are not detected are saved as "false".
  // Metadata features that *are* detected are saved using the following object structure:
  // {
  //   "present": "true",             // Indicates that the feature appears in the structure or any of its children.
  //   "delegated": ["true"|"false"]  // Whether the feature can only be detected outside the original test function.
  // }
  // 
  // 
  // These features typically "bubble up" from nested structures to their parents, but the
  // details may vary slightly depending on the context. Similarly, the interpretation of
  // each feature's fields may vary depending on the context.
  // 
  // 
  // In these analyses, a feature is considered "delegated" if it can only be detected
  // outside the original test function, i.e. in a helper function. Features detected
  // inside a closure that is itself inside the test function are not considered delegated.
  // 
  // Additionally, a structure containing metadata features is considered delegated if the
  // structure itself is located outside the original test function, or if any of its
  // detected metadata features are delegated. In other words, a delegated structure 
  // "relies on" external helper functions for its features to be detected.
  // 


  // The "LoopAnalysis" object contains information about the loops detected in the test case. This field
  // is only present if the `--analyze-loops` option is set.
  "LoopAnalysis": {
    // The number of non-nested loops where the loop itself and all detected metadata features are found inside
    // the test function itself.
    "numLocalLoops": 1,

    // The number of non-nested loops where the loop itself or any detected metadata features can only be found
    // outside the test function itself, e.g. in a helper function.
    "numDelegatedLoops": 0,
    
    // Information about all detected loops (both local and delegated), or "null" if none were detected.
    // Loops that appear within other loops are considered to be nested within the corresponding parent.
    "loops": [
      {
        // The classification of the loop's structure.
        // 
        // - For a range loop over a slice/array of structs,   e.g. `for _, s := range []struct{...}`,
        //   this will be "range structs".
        // - For a range loop over a slice/array of non-struct elements,   e.g. `for _, x := range []int{...}`,
        //   this will be "range non-structs".
        // - For a range loop over a map of keys/values,   e.g. `for k, v := range map[string]int{...}`,
        //   this will be "range map".
        // - For a range loop over an integer value directly,   e.g. `for i := range 10`,
        //   this will be "range int".
        // - For a range loop over something not categorized above (including strings, channels, or iterators),
        //   e.g. `for _, c := range "hello"`,   this will be "range other".
        // - For a three-clause loop using an integer index variable,   e.g. `for i := 0; i < 10; i++`,
        //   this will be "iterative indexed".
        // - For a three-clause loop that does not use an integer index variable,
        //   e.g. `for p := head; p != nil; p = p.Next`,   this will be "iterative non-indexed".
        // - For a loop only containing a condition, acting as a while loop,   e.g. `for condition { ... }`,
        //   this will be "condition-only".
        // - For a loop with no clauses,   e.g. `for { ... }`,   this will be "infinite".
        // - For a loop with an unrecognized structure, this will be "unknown".
        // - If no loop was detected, this will be "none".
        "loopType": "range structs",
        
        // The loop's content, based on its AST representation.
        "content": "for i, test := range tests {\n\trule := NewAlertingRule(test.name, nil, 0, 0, labels.EmptyLabels(), labels.EmptyLabels(), labels.EmptyLabels(), \"\", true, nil)\n\trule.active = test.active\n\tgot := rule.State()\n\trequire.Equal(t, test.want, got, \"test case %d unexpected AlertState, want:%d got:%d\", i, test.want, got)\n\tvalidateState(t, got)\n}",

        // A boolean indicating whether the loop is indicative of a table-driven test. Note that this is
        // determined based on this object's analysis fields, so this may differ from the "isTableDriven"
        // field in the "ScenarioSet" object, which is determined using different criteria.
        "indicatesTableDriven": true,
        
        // A boolean indicating whether the loop structure or any of its metadata features are delegated.
        "delegated": false,

        // A metadata feature indicating whether the loop defines subtests using the built-in `t.Run`
        // method or a library-based equivalent.
        "hasSubtest": false,
        
        // A metadata feature indicating whether the loop contains an assertion, detected based on
        // the presence of built-in or library-based test failure or assertion functions.
        "hasAssertion": {
          "present": true,
          "delegated": false
        },

        // A metadata feature indicating whether the loop contains a return statement that exits the
        // loop's enclosing function. Being delegated only indicates that the loop is in a helper function.
        "hasEarlyExit": false,
        
        // A boolean indicating whether the loop directly mutates any data defined outside the loop.
        // This does not include mutations that may occur indirectly through function calls.
        // This cannot be delegated because it is determined based on the loop's own scope.
        "doesExternalMutation": false,
        
        // Information about any additional loops that are contained within this loop, if any.
        // Nested loops follow the same structure as non-nested ones, and are recursively expanded
        // in the same way.
        "nestedLoops": [
          {
            "loopType": "iterative indexed",
            "content": "for i := 0; i < 3; i++ {\n\tif other := AlertState(i); other == state {\n\t\tif other.String() != state.String() {\n\t\t\tt.Errorf(\"unexpected AlertState string, want:%q got:%q\", other.String(), state.String())\n\t\t}\n\t}\n}",
            "indicatesTableDriven": true,
            "delegated": true,
            "hasSubtest": false,
            "hasAssertion": {
              "present": true,
              "delegated": true
            },
            "hasEarlyExit": false,
            "doesExternalMutation": false
          }
        ]
      }
    ]
  },

  // The "IfElseAnalysis" object contains information about the if/else chains detected in the runner
  // loop of a table-driven test. This field is only present if the `--analyze-conditionals` option is set.
  "IfElseAnalysis": {
    // The number of non-nested if/else chains detected in the test, including those in helper functions.
    "numConditionals": 1,

    // Information about all detected if/else chains in the test, or "null" if none were detected.
    // If/else chains that appear within other if/else clauses are considered to be nested within the
    // corresponding parent clause.
    "conditionals": [
      {
        // The entire if/else chain's content, based on its AST representation.
        "content": "if other := AlertState(i); other == state {\n\tif other.String() != state.String() {\n\t\tt.Errorf(\"unexpected AlertState string, want:%q got:%q\", other.String(), state.String())\n\t}\n}",

        // A boolean indicating whether the if/else chain is located outside of the test function itself.
        "inHelper": true,

        // Information about each individual clause of this if/else chain.
        "clauses": [
          {
            // The classification of the clause's type. Either "then", "else if", or "else".
            "type": "then",

            // The condition corresponding to this clause, based on its AST representation.
            // This is omitted for "else" clauses.
            "condition": "other := AlertState(i); other == state",

            // Information about each of the variables and fields used inside this clause's condition.
            "variables": [
              {
                // The name of the variable or field.
                "name": "other",
                
                // The classification of the location where the variable is defined.
                // 
                // - If the variable is the detected scenario data structure or one of its fields, this will be "scenario".
                // - If the variable is defined in the initialization statement of this clause, this will be "if scope".
                // - If the variable is defined in the surrounding table-driven runner loop, this will be "loop scope".
                // - If the variable is defined in the surrounding test function, this will be "test scope".
                // - If the variable is defined as a global variable in this package, imported from another package, or
                //   defined in a helper function, this will be "package".
                // - If the variable's source cannot be determined, this will be "unknown".
                "source": "if scope",

                // The classifications of the ways that this variable is used in the clause's condition.
                // 
                // - For a direct boolean check,    e.g. `if tt.ok` or `if !localBool`,   this will be "direct check".
                // - For a binary comparison check,    e.g. `if tt.val == 5`,   this will be "comparison".
                // - For a method call receiver,    e.g. `if tt.field.IsValid()`,   this will be "method receiver".
                // - For a local function call,    e.g. `if tt.setup()` or `if localFunc()`,   this will be "function call".
                // - For a function call argument,    e.g. `if helper(tt.val)`,   this will be "function argument".
                // - For a value involved in a computation,    e.g. `if val/2 > 10`,   this will be "computation".
                // - For a variable assigned in the clause's initialization statement, e.g. `if got := ...`,   this
                //   will be "variable creation".
                // - For a variable usage that cannot be classified, this will be "other".
                "usages": [
                  "variable creation",
                  "comparison"
                ]
              },
              {
                "name": "i",
                "source": "package",
                "usages": [
                  "function argument"
                ]
              },
              {
                "name": "state",
                "source": "package",
                "usages": [
                  "comparison"
                ]
              }
            ],

            // The number of statements contained directly in this clause, not including nested statements.
            "length": 1,
            
            // A boolean indicating whether the clause or any of its metadata features are delegated.
            "delegated": true,
            
            // A metadata feature indicating whether the clause defines subtests using the built-in `t.Run`
            // method or a library-based equivalent.
            "hasSubtest": false,
            
            // A metadata feature indicating whether the clause contains an assertion, detected based on
            // the presence of built-in or library-based test failure or assertion functions.
            "hasAssertion": {
              "present": true,
              "delegated": true
            },
            
            // A metadata feature indicating whether the clause contains a return statement that exits the
            // clause's enclosing function. Being delegated only indicates that the clause is in a helper function.
            "hasEarlyExit": false,
            
            // A boolean indicating whether the clause directly mutates any data defined outside the clause.
            // This does not include mutations that may occur indirectly through function calls.
            // This cannot be delegated because it is determined based on the clause's own scope.
            "doesExternalMutation": false,

            // Information about any additional if/else chains that are contained within this clause, if any.
            // Nested conditionals follow the same structure as non-nested ones, and are recursively expanded
            // in the same way.
            "nestedConditionals": [
              {
                "content": "if other.String() != state.String() {\n\tt.Errorf(\"unexpected AlertState string, want:%q got:%q\", other.String(), state.String())\n}",
                "inHelper": true,
                "clauses": [
                  {
                    "type": "then",
                    "condition": "other.String() != state.String()",
                    "variables": [
                      {
                        "name": "other",
                        "source": "package",
                        "usages": [
                          "method receiver"
                        ]
                      },
                      {
                        "name": "state",
                        "source": "package",
                        "usages": [
                          "method receiver"
                        ]
                      }
                    ],
                    "length": 1,
                    "delegated": true,
                    "hasSubtest": false,
                    "hasAssertion": {
                      "present": true,
                      "delegated": true
                    },
                    "hasEarlyExit": false,
                    "doesExternalMutation": false
                  }
                ]
              }
            ]
          }
        ]
